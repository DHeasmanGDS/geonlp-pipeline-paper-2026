# Template environment file. Copy to `.env` and fill in your own values.
# .env is gitignored — never commit a populated .env file.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=geonlp
DB_PASSWORD=change_me_to_your_local_password
DB_NAME=geonlp_db

