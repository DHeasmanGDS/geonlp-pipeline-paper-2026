# GeoNLP Portal — local dev DB credentials
# Copy this file to services/.env and fill in DB_PASSWORD.
# In production these come from the geonlp-env Kubernetes secret.
#
# To fetch the password from the NUC:
#   ssh drew@192.168.4.133
#   kubectl get secret geonlp-env -o jsonpath='{.data.DB_PASSWORD}' | base64 -d
#
# Network note: your dev machine must be on the LAN (or VPN'd in) to reach
# 192.168.4.37:5432 directly. Test with:
#   nc -zv 192.168.4.37 5432
#   (PowerShell) Test-NetConnection 192.168.4.37 -Port 5432

DB_HOST=192.168.4.37
DB_PORT=5432
DB_USER=geonlp
DB_PASSWORD=<paste-here>
DB_NAME=geonlp_db
